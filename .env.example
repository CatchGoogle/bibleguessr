# Copy this file to .env.local and fill in a Supabase project.
# In the Supabase SQL editor, run supabase/migrations/001_init.sql first.
# Use the anon public key. Never put the service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# The admin panel is /av6. It is not linked from the public pages.
